class Solution {
public:
    vector<int> nextGreaterElement(vector<int>& nums1, vector<int>& nums2) {
     int m = nums1.size();
     int n = nums2.size();
     vector<int> result;
     vector<int> nextGreaterInNums2(n);
     stack<int> st;
     for(int i = n-1 ; i>=0 ; i--){
        while( !st.empty() && st.top()<=nums2[i]){
            st.pop();
        }
         if(st.empty()) nextGreaterInNums2[i]=-1;
         else nextGreaterInNums2[i]=st.top();
         st.push(nums2[i]);
     }
     unordered_map<int , int> mp;
     for(int i = 0 ; i < n ; i++){
        mp[nums2[i]]=i;
     }
    for(int i = 0 ; i< m ; i++){
            result.push_back(nextGreaterInNums2[mp[nums1[i]]]);
    }
return result;
    }
};
