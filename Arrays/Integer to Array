class Solution {
public:
    string intToRoman(int nums) {
        vector<string> symbols = {"M", "CM" ,"D" ,"CD","C" ,"XC" ,"L" ,"XL" ,"X" ,"IX" ,"V" ,"IV" , "I"};
        vector<int> num = {1000 ,900, 500,400, 100,90, 50,40, 10,9, 5,4, 1};
     
        string ans = "";
        for(int i = 0 ; i < num.size() ; i++){
            while(nums>=num[i]){
             ans += symbols[i];
             nums -= num[i];
            }
        }

   return ans;
    }
};
